+
+@Composable
+private fun ProxySettingsDialog(
+    initialType: Int,
+    initialHost: String,
+    initialPort: String,
+    onDismiss: () -> Unit,
+    onConfirm: (type: Int, host: String, port: String) -> Unit,
+) {
+    var selectedType by remember { mutableStateOf(initialType) }
+    var host by remember { mutableStateOf(initialHost) }
+    var port by remember { mutableStateOf(initialPort) }
+    val types = listOf(
+        EhProxySelector.TYPE_DIRECT to "Direct (no proxy)",
+        EhProxySelector.TYPE_SYSTEM to "System proxy",
+        EhProxySelector.TYPE_HTTP to "HTTP proxy",
+        EhProxySelector.TYPE_SOCKS to "SOCKS proxy",
+    )
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Proxy settings") },
+        text = {
+            Column {
+                types.forEach { (type, label) ->
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        RadioButton(selected = selectedType == type, onClick = { selectedType = type })
+                        Text(label, modifier = Modifier.clickable { selectedType = type })
+                    }
+                }
+                Spacer(Modifier.height(8.dp))
+                TextField(
+                    value = host,
+                    onValueChange = { host = it },
+                    label = { Text("Host / IP") },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Spacer(Modifier.height(8.dp))
+                TextField(
+                    value = port,
+                    onValueChange = { port = it.filter { c -> c.isDigit() } },
+                    label = { Text("Port") },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    modifier = Modifier.fillMaxWidth(),
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(onClick = { onConfirm(selectedType, host.trim(), port.trim()) }) {
+                Text("Save")
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) {
+                Text("Cancel")
+            }
+        },
+    )
+}
