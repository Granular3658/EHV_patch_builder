+package com.hippo.ehviewer
+
+import com.hippo.ehviewer.Settings.proxyIp
+import com.hippo.ehviewer.Settings.proxyPort
+import com.hippo.ehviewer.Settings.proxyType
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.Proxy
+
+/**
+ * Restored from the historical in-app proxy support that was dropped in
+ * 53bbabab75. Builds the [Proxy] the OkHttp engine should use based on the
+ * user-configured proxy type / host / port in [Settings].
+ */
+object EhProxySelector {
+    const val TYPE_DIRECT = 0
+    const val TYPE_SYSTEM = 1
+    const val TYPE_HTTP = 2
+    const val TYPE_SOCKS = 3
+
+    val currentProxy: Proxy
+        get() = when (proxyType) {
+            TYPE_DIRECT, TYPE_SYSTEM -> Proxy.NO_PROXY
+            TYPE_HTTP -> buildProxy(Proxy.Type.HTTP)
+            TYPE_SOCKS -> buildProxy(Proxy.Type.SOCKS)
+            else -> Proxy.NO_PROXY
+        }
+
+    private fun buildProxy(type: Proxy.Type): Proxy {
+        val ip = proxyIp
+        val port = proxyPort
+        if (!ip.isNullOrEmpty() && port in 1..65535) {
+            runCatching {
+                val address = InetSocketAddress(InetAddress.getByName(ip), port)
+                return Proxy(type, address)
+            }
+        }
+        return Proxy.NO_PROXY
+    }
+}
